{
  "name": "@arcgis-test/maps-toolkit",
  "version": "0.1.0",
  "description": "Reusable helpers and a sample app for the ArcGIS Maps SDK for JavaScript",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pure": "./src/pure/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["arcgis", "maps", "esri", "javascript", "webmap"],
  "peerDependencies": {
    "@arcgis/core": ">=4.29"
  },
  "peerDependenciesMeta": {
    "@arcgis/core": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
