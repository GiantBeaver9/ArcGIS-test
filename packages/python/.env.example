# Copy to .env and fill in. .env is git-ignored.

# Portal URL (ArcGIS Online default shown; use your Enterprise URL otherwise)
ARCGIS_URL=https://www.arcgis.com

# --- Option A: username / password ---
ARCGIS_USERNAME=
ARCGIS_PASSWORD=

# --- Option B: API key (leave username/password blank if you use this) ---
ARCGIS_API_KEY=

# Optional: profile name stored by the arcgis SDK keyring
ARCGIS_PROFILE=
